# Mansam Chatbot & Server Environment Configuration

# Hugging Face Access Token for LLM Chat and Whisper Speech Fallback
HF_TOKEN=your_hugging_face_token_here

# Optional: Hugging Face Router & Model Settings
# HF_API_URL=https://router.huggingface.co/v1/chat/completions
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
# HF_TIMEOUT_SECONDS=20

# Optional: Hugging Face Gradio Space (alternative to router)
# HF_GRADIO_SPACE=https://akhaliq-glm-5-3-flash.hf.space
# HF_GRADIO_API_NAME=/answer
# HF_GRADIO_TOKEN=your_hf_token_here

# Optional: Audio Speech Recognition Model
# ASR_MODEL=openai/whisper-large-v3
# ASR_API_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3

# ── Meta / Facebook Integration ──────────────────────────────────────────────

# Meta Pixel & Conversions API (CAPI) – server-side event mirroring
META_PIXEL_ID=2617857485322638
META_CAPI_TOKEN=your_meta_capi_access_token_here

# Meta Lead Ads Webhook – receive real-time lead form submissions
# Generate at: https://developers.facebook.com/apps → Your App → Webhooks
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here

# Meta Graph API Webhook – page events, messages, etc.
# Same verify token is reused; set a strong random string (e.g. openssl rand -hex 32)
# META_WEBHOOK_VERIFY_TOKEN=same_token_above
